# SiliconFlow API 密钥（必填）
SILICONFLOW_API_KEY=

# SiliconFlow OpenAI 兼容接口地址（一般无需修改）
LLM_BASE_URL=https://api.siliconflow.cn/v1

# 模型名称（均可从硅基流动模型广场替换，代码不写死）
CHAT_MODEL=deepseek-ai/DeepSeek-V3
SMALL_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBED_MODEL=BAAI/bge-m3

# 是否启用意图路由（小模型分流简单/复杂问题）
ENABLE_INTENT_ROUTING=true

# 嵌入批量大小（入库加速）
EMBED_BATCH_SIZE=16

# ---------- RAG 分块与检索 ----------
# 单块最大字符数 / 相邻块重叠字符数（滑动窗口，避免上下文在边界被切断）
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 向量召回候选数（rerank 前）/ 重排序后保留数
RAG_TOP_K=8
RAG_RERANK_TOP_N=3
# 向量相似度阈值（召回阶段过滤噪声）
RAG_SCORE_THRESHOLD=0.25

# ---------- 重排序（硅基流动 rerank 端点，不可用时自动降级）----------
ENABLE_RERANK=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_SCORE_THRESHOLD=0.1

# 服务访问密钥（可选；留空则关闭校验）
API_KEY=

# 允许跨域来源（开发用 *，生产请改为具体域名）
CORS_ORIGINS=*

# ---------- QQ 机器人（官方平台 bot.q.qq.com，可选）----------
# 在平台创建机器人后获得；首次运行 scripts/connect_qqbot.py 会自动打开管理页引导填写
QQ_BOT_APPID=
QQ_BOT_SECRET=
# 事件订阅 intents 位掩码；默认 1<<25 = 群@消息 + 单聊消息
QQ_BOT_INTENTS=33554432
